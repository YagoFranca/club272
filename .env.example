# Copie para `.env` e preencha com as credenciais do seu projeto Supabase.
# Settings -> API no painel do Supabase.

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Chave pública "anon" — usada nas operações normais da aplicação.
SUPABASE_KEY=

# Chave "service_role" — só necessária para o Storage. Tem privilégio total,
# não distribua junto com o executável e não versione.
SUPABASE_STORAGE_KEY=

# Nome da tabela de usuários no Supabase.
SUPABASE_TABLE=FaceAttendenceRealTime

# Timeout (segundos) das chamadas HTTP.
SUPABASE_TIMEOUT=10

# Distância máxima na comparação de rostos (menor = mais rigoroso).
FACE_TOLERANCE=0.45
